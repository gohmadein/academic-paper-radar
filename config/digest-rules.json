    "bilingualGuides": {
      "required": true,
      "order": [
        "Chinese",
        "English"
      ],
      "englishMustTranslateChineseGuide": true,
      "noNewUnsupportedClaims": true
    },
    "figures": {
      "source": "actual-paper-or-author-project",
      "bundleSameOrigin": true,
      "optimizeWithoutChangingMeaning": true,
      "missing": "explicit-no-verified-figure",
      "noGeneratedScientificImages": true,
      "provenanceAndRightsRequired": true
    },
    "affiliations": {
      "source": "paper-specific-evidence",
      "noCurrentEmployerInference": true,
      "restrictedLogo": "named-text-label-only",
      "noEndorsementBadge": true,
      "universityMark": "official-crest-emblem-or-compact-identity-symbol-not-long-wordmark",
      "organizationMark": "own-official-mark-no-umbrella-substitution",
      "compactMarkSize": 32,
      "noCroppingWordmarkIntoEmblem": true,
      "missingPermittedEmblem": "institution-name-only-no-initial-badge",
      "transparentMarkBackground": "transparent-container-prefer-genuine-alpha-originals",
      "noBadgePlateOrDarkBacking": true,
      "noArtificialInstitutionInitialBadge": true,
      "neverRegenerateOfficialMarks": true,
      "opaqueOriginalException": "Record actual background honestly; preserve authentic Tsinghua white-background original on white card rather than altering logo",
      "registry": "data/institutions.json: resolve stable IDs and aliases before any search; reuse verified path/hash; append new institutions once as needs-verification, never infer paper affiliations from catalogue membership",
      "gallery": "manual horizontal browsing only; verified paper affiliations, not partners; no autoplay"
    },
    "portraits": {
      "source": "official-page-explicitly-identifies-author",
      "neverUseInstitutionLogoAsFace": true,
      "missing": "full-name-only-no-fake-avatar"
    },
    "sharing": {
      "onlyPublicPaperURL": true,
      "noLikesOrViewCounts": true
    },
    "assetPublishing": "Reuse identical verified local assets; publish changed assets plus day/index/paper registry/institution registry in one atomic commit; validate all references, hashes, dimensions and evidence. Browser HTTP cache is not a guarantee of zero network requests."
  }
