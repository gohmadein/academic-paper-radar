{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "研究信号日期索引",
  "type": "object",
  "required": ["version", "days"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "days": { "type": "array", "items": { "type": "object", "required": ["date", "file", "count", "title"], "additionalProperties": false, "properties": { "date": { "type": "string", "format": "date" }, "file": { "type": "string", "pattern": "^days/\\d{4}-\\d{2}-\\d{2}\\.json$" }, "count": { "type": "integer", "minimum": 0 }, "title": { "type": "string", "minLength": 1, "maxLength": 120 } } } }
  }
}
