{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "迅每日arXiv公告简报（非精选导读卡）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "date",
    "announcementDate",
    "checkedAt",
    "status",
    "coverage",
    "entries"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "announcementDate": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "checkedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkedCategories",
        "checkedCount",
        "includedCount",
        "limitations",
        "categoryStatus"
      ],
      "properties": {
        "checkedCategories": {
          "type": "array",
          "items": {
            "enum": [
              "cs.RO",
              "cs.CV",
              "cs.LG",
              "cs.AI",
              "eess.SY",
              "eess.IV"
            ]
          },
          "uniqueItems": true
        },
        "checkedCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "includedCount": {
          "type": "integer",
          "minimum": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "categoryStatus": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "status",
              "announcementDate",
              "listedCount",
              "checkedCount",
              "sourceUrl"
            ],
            "properties": {
              "category": {
                "enum": [
                  "cs.RO",
                  "cs.CV",
                  "cs.LG",
                  "cs.AI",
                  "eess.SY",
                  "eess.IV"
                ]
              },
              "status": {
                "enum": [
                  "complete",
                  "partial",
                  "unavailable"
                ]
              },
              "announcementDate": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "listedCount": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "checkedCount": {
                "type": "integer",
                "minimum": 0
              },
              "sourceUrl": {
                "type": "string",
                "pattern": "^https://(www\\.|export\\.)?arxiv\\.org/"
              }
            }
          },
          "minItems": 6,
          "maxItems": 6
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "arxivId",
          "version",
          "titleEn",
          "titleZh",
          "authors",
          "publishedDate",
          "updatedDate",
          "change",
          "categories",
          "url",
          "topics",
          "announcements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^arxiv-\\d{4}-\\d{4,5}$"
          },
          "arxivId": {
            "type": "string",
            "pattern": "^\\d{4}\\.\\d{4,5}$"
          },
          "version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "titleEn": {
            "type": "string",
            "minLength": 1
          },
          "titleZh": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "publishedDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "updatedDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "change": {
            "enum": [
              "new",
              "revised",
              "cross-list"
            ]
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://arxiv\\.org/abs/\\d{4}\\.\\d{4,5}(v[1-9]\\d*)?$"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "announcements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "change"
              ],
              "properties": {
                "category": {
                  "enum": [
                    "cs.RO",
                    "cs.CV",
                    "cs.LG",
                    "cs.AI",
                    "eess.SY",
                    "eess.IV"
                  ]
                },
                "change": {
                  "enum": [
                    "new",
                    "revised",
                    "cross-list"
                  ]
                }
              }
            },
            "minItems": 1
          }
        }
      }
    }
  }
}
