{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "零域分类日报 v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "date",
    "title",
    "demo",
    "timezone",
    "issueNote",
    "coverage",
    "papers"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "demo": {
      "const": false
    },
    "timezone": {
      "const": "Asia/Shanghai"
    },
    "issueNote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkedSources",
        "limitations"
      ],
      "properties": {
        "checkedSources": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        }
      }
    },
    "papers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/paper"
      }
    }
  },
  "$defs": {
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "titleEn",
        "authors",
        "year",
        "venue",
        "tags",
        "summary",
        "whySelected",
        "sources",
        "demo",
        "profiles",
        "recommendations",
        "identity",
        "publicationStatus",
        "publicationDate",
        "discoveredDate",
        "verifiedAt",
        "readDepth",
        "paperType",
        "classic",
        "novelty",
        "updateNote",
        "links",
        "limits",
        "assumptions",
        "evidence",
        "researchNotes",
        "summaryEn",
        "visuals"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "titleEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "authors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "minItems": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2200
        },
        "venue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "tags": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "minItems": 1
        },
        "summary": {
          "type": "string",
          "minLength": 100,
          "maxLength": 200
        },
        "whySelected": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "url"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              }
            }
          }
        },
        "demo": {
          "const": false
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "xun",
              "li",
              "lv"
            ]
          }
        },
        "recommendations": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "xun": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "whyRead",
                "relation",
                "prerequisites",
                "difficulty",
                "readRecommendation"
              ],
              "properties": {
                "whyRead": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                },
                "relation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                },
                "prerequisites": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  }
                },
                "difficulty": {
                  "enum": [
                    "beginner",
                    "intermediate",
                    "advanced"
                  ]
                },
                "readRecommendation": {
                  "enum": [
                    "skim",
                    "read",
                    "deep",
                    "save"
                  ]
                }
              }
            },
            "li": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "whyRead",
                "relation",
                "prerequisites",
                "difficulty",
                "readRecommendation"
              ],
              "properties": {
                "whyRead": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                },
                "relation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                },
                "prerequisites": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  }
                },
                "difficulty": {
                  "enum": [
                    "beginner",
                    "intermediate",
                    "advanced"
                  ]
                },
                "readRecommendation": {
                  "enum": [
                    "skim",
                    "read",
                    "deep",
                    "save"
                  ]
                }
              }
            },
            "lv": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "whyRead",
                "relation",
                "prerequisites",
                "difficulty",
                "readRecommendation"
              ],
              "properties": {
                "whyRead": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                },
                "relation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                },
                "prerequisites": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  }
                },
                "difficulty": {
                  "enum": [
                    "beginner",
                    "intermediate",
                    "advanced"
                  ]
                },
                "readRecommendation": {
                  "enum": [
                    "skim",
                    "read",
                    "deep",
                    "save"
                  ]
                }
              }
            }
          },
          "minProperties": 1
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "doi",
            "arxiv",
            "other"
          ],
          "properties": {
            "doi": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^10\\.\\d{4,9}/.+"
                },
                {
                  "type": "null"
                }
              ]
            },
            "arxiv": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                },
                {
                  "type": "null"
                }
              ]
            },
            "other": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "publicationStatus": {
          "enum": [
            "published",
            "accepted",
            "preprint",
            "workshop",
            "unknown"
          ]
        },
        "publicationDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "discoveredDate": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "verifiedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "readDepth": {
          "enum": [
            "metadata",
            "abstract",
            "fulltext"
          ]
        },
        "paperType": {
          "enum": [
            "theory",
            "system",
            "empirical",
            "survey",
            "benchmark"
          ]
        },
        "classic": {
          "type": "boolean"
        },
        "novelty": {
          "enum": [
            "recent",
            "older-discovery",
            "major-update"
          ]
        },
        "updateNote": {
          "type": "string"
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "project",
            "video",
            "data"
          ],
          "properties": {
            "code": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                {
                  "type": "null"
                }
              ]
            },
            "project": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                {
                  "type": "null"
                }
              ]
            },
            "video": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                {
                  "type": "null"
                }
              ]
            },
            "data": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "limits": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "claim",
              "checkedAt"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "claim": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "checkedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "string",
                    "format": "date-time"
                  }
                ]
              }
            }
          }
        },
        "researchNotes": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "summaryEn": {
          "type": "string",
          "minLength": 40,
          "maxLength": 5000
        },
        "visuals": {
          "$ref": "#/$defs/visuals"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "profiles": {
                "contains": {
                  "const": "xun"
                }
              }
            }
          },
          "then": {
            "properties": {
              "recommendations": {
                "required": [
                  "xun"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "profiles": {
                "contains": {
                  "const": "li"
                }
              }
            }
          },
          "then": {
            "properties": {
              "recommendations": {
                "required": [
                  "li"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "profiles": {
                "contains": {
                  "const": "lv"
                }
              }
            }
          },
          "then": {
            "properties": {
              "recommendations": {
                "required": [
                  "lv"
                ]
              }
            }
          }
        }
      ]
    },
    "mediaAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256",
        "width",
        "height",
        "sourceUrl",
        "evidenceUrl",
        "verifiedAt",
        "credit",
        "rights",
        "displayPolicy",
        "background",
        "altZh",
        "altEn"
      ],
      "properties": {
        "kind": {
          "enum": [
            "figure",
            "institution-logo",
            "author-portrait"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^assets/(papers|institutions|authors)/[a-zA-Z0-9_./-]+\\.(png|jpe?g|webp|svg)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "evidenceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "verifiedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "credit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "rights": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "displayPolicy": {
          "enum": [
            "open-license",
            "official-brand",
            "attributed-thumbnail"
          ]
        },
        "background": {
          "enum": [
            "light",
            "dark",
            "transparent"
          ]
        },
        "altZh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "altEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        }
      }
    },
    "visuals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mainFigure",
        "figureNote",
        "institutions",
        "authors"
      ],
      "properties": {
        "mainFigure": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/mediaAsset"
                },
                {
                  "properties": {
                    "kind": {
                      "const": "figure"
                    }
                  }
                }
              ]
            }
          ]
        },
        "figureNote": {
          "type": "string"
        },
        "institutions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "logo",
              "authorNames",
              "evidence",
              "note",
              "institutionType",
              "markType"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000
              },
              "logo": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/mediaAsset"
                      },
                      {
                        "properties": {
                          "kind": {
                            "const": "institution-logo"
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              "authorNames": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 5000
                }
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "url",
                    "claim",
                    "checkedAt"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https?://"
                    },
                    "claim": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 5000
                    },
                    "checkedAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date"
                        },
                        {
                          "type": "string",
                          "format": "date-time"
                        }
                      ]
                    }
                  }
                }
              },
              "note": {
                "type": "string"
              },
              "institutionType": {
                "enum": [
                  "university",
                  "research-institute",
                  "company",
                  "chair"
                ]
              },
              "markType": {
                "enum": [
                  "emblem",
                  "organization-mark",
                  "none",
                  "compact-symbol"
                ]
              },
              "institutionId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "institutionType": {
                      "const": "university"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "markType": {
                      "enum": [
                        "emblem",
                        "none",
                        "compact-symbol"
                      ]
                    }
                  }
                },
                "else": {
                  "properties": {
                    "markType": {
                      "enum": [
                        "organization-mark",
                        "none"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "markType": {
                      "const": "none"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "logo": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "logo": {
                      "type": "object"
                    }
                  }
                }
              }
            ]
          }
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "portrait",
              "note"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000
              },
              "portrait": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/mediaAsset"
                      },
                      {
                        "properties": {
                          "kind": {
                            "const": "author-portrait"
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
